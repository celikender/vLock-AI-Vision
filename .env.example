# Active camera photo analysis provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Meta Model API: Muse Spark rule proposals (working app) and the SAM cloud experiment.
# Copy to .env and set your Meta developer key locally.
# Keep the key out of source control and chat messages.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_SAM_MODEL=sam-3.1
META_MUSE_MODEL=muse-spark-1.3

# SAM backend: local (default, needs the GPU worker) or meta_api (no GPU; uses META_API_KEY).
# meta_api sends camera frames to Meta and is billed per frame and phrase.
VLOCK_SAM_BACKEND=local
VLOCK_SAM_TIMEOUT_MS=3000

# OPC UA network access (Integrations > OPC UA > Access: Network). SCADA on another PC
# logs in with these; the password needs 12+ characters. Not needed for This PC only.
VLOCK_OPCUA_SERVER_USERNAME=
VLOCK_OPCUA_SERVER_PASSWORD=

# Optional: require "Authorization: Bearer <token>" for the SCADA REST API (/api/v1/...).
VLOCK_API_TOKEN=

# Docker only: your own Hugging Face token (approved for facebook/sam3.1). The sam container
# downloads the weights once with it; the images never contain the weights. See docs/DOCKER.md.
HF_TOKEN=

